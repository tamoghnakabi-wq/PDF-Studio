{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDF Studio",
  "version": "1.1.1",
  "identifier": "com.tamoghna.pdfstudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PDF Studio",
        "label": "main",
        "width": 1240,
        "height": 800,
        "minWidth": 980,
        "minHeight": 660,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": true,
        "theme": null
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**",
          "/Volumes/**",
          "/private/tmp/**",
          "/tmp/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "copyright": "© 2026 Tamoghna Kabi",
    "shortDescription": "Every PDF tool you need, on your Mac.",
    "longDescription": "PDF Studio is an offline-first macOS app for working with PDFs: merge, split, compress, rotate, rearrange, extract or delete pages, watermark, page numbers, convert to and from images, Word to PDF, text extraction and OCR.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-",
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "name": "PDF Document",
        "description": "PDF Document",
        "role": "Viewer",
        "mimeType": "application/pdf"
      },
      {
        "ext": [
          "jpg",
          "jpeg"
        ],
        "name": "JPEG Image",
        "description": "JPEG Image",
        "role": "Viewer",
        "mimeType": "image/jpeg"
      },
      {
        "ext": [
          "png"
        ],
        "name": "PNG Image",
        "description": "PNG Image",
        "role": "Viewer",
        "mimeType": "image/png"
      },
      {
        "ext": [
          "docx"
        ],
        "name": "Word Document",
        "description": "Word Document",
        "role": "Viewer"
      }
    ],
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/tamoghnakabi/pdf-studio/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY5RDFBMDI3NkY2OUE3ODAKUldTQXAybHZKNkRSYVZrTjR3RXFxcXpvYmJteldCYXNmd3MrbjV4MmV4b0toU2QzbjFrbW1vVmkK"
    }
  }
}
